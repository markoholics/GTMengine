# Copy to .env. Never commit .env. In CI and Make, set these as secrets, not files.

# Database (Supabase: Connect > Session pooler string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/signals
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server side only. Bypasses RLS. Never ship to a browser

# Which client this process works for (matches clients.name)
GTM_CLIENT=byosync

# Providers (leave empty until the phase that needs them)
GITHUB_TOKEN=
APIFY_TOKEN=
ANTHROPIC_API_KEY=
APOLLO_API_KEY=
BREVO_API_KEY=                  # dormant: Apollo sequences are the send path
SEND_FROM=rahman@markoholics.com

# Webhooks (Phase 6)
WEBHOOK_SHARED_SECRET=
ALERT_WEBHOOK_URL=              # Make or Slack incoming webhook for failure alerts

# Google (Phase 7)
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS= # path to a service account JSON kept outside the repo
